# Settings for the DeepSeek-V4-Flash CPU deployment.
# Copy to deploy/config.env and edit; every script reads that file if it exists.
# Any variable can also be overridden from the environment for a single run.

# Where ik_llama.cpp is built and where models are stored.
INSTALL_DIR=/opt/deepseek-cpu

# ik_llama.cpp source. The commit is pinned so every server runs the same code;
# bump it deliberately and re-run deploy/bench.sh before rolling out.
IK_LLAMA_REPO=https://github.com/ikawrakow/ik_llama.cpp.git
IK_LLAMA_COMMIT=d741de5074cd424dd3ba7cfc4d9b7649f1eb0463

# Model. UD-Q8_K_XL (~162 GB) keeps the routed experts in their native MXFP4 and
# the rest at 8 bit: effectively lossless. UD-Q4_K_XL (~155 GB) also quantizes the
# non-expert weights to 4 bit, which reads fewer bytes per token (faster decode)
# at a small quality cost. Measure both with deploy/bench.sh.
HF_REPO=unsloth/DeepSeek-V4-Flash-0731-GGUF
QUANT=UD-Q8_K_XL
MODEL_DIR=${INSTALL_DIR}/models/DeepSeek-V4-Flash-0731-GGUF
# Optional explicit path to the .gguf file (first shard if split). Auto-detected
# from MODEL_DIR and QUANT when empty.
MODEL_FILE=
MODEL_ALIAS=deepseek-v4-flash

# Server. Keep HOST=127.0.0.1 unless an API key is set and the port is firewalled.
HOST=127.0.0.1
PORT=8080
# Clients must send "Authorization: Bearer <key>". Either set the key here, or
# point API_KEY_FILE at a file readable only by the service user (one key per line).
API_KEY=
API_KEY_FILE=

# NUMA placement on multi-socket servers:
#   auto       per-node if each NUMA node has room for its own copy of the model, else interleave
#   none       no pinning (single-socket servers)
#   interleave one server spread over all nodes (numactl --interleave=all)
#   per-node   one server per NUMA node on PORT, PORT+1, ... (put deploy/nginx.conf.example in front)
NUMA_MODE=auto

# Threads per server. Empty = physical cores (of the node in per-node mode).
THREADS=

# Concurrent request slots per server, and context length per slot.
# Total context allocated = PARALLEL * CTX_PER_SLOT.
PARALLEL=4
CTX_PER_SLOT=32768

# Host-memory prompt cache in MiB. Reusing cached prefixes is what keeps
# time-to-first-token low for chat and agents with long, repeated prompts.
CACHE_RAM_MIB=32768

# Lock the model in RAM (needs LimitMEMLOCK=infinity; the systemd unit sets it).
MLOCK=1

# Speculative decoding, off by default. Try e.g. SPEC_TYPE="mtp:n_max=1" and
# compare with deploy/bench.sh before enabling in production.
SPEC_TYPE=

# Extra llama-server arguments, e.g. EXTRA_ARGS="-rtr" or "--webui none".
EXTRA_ARGS=
