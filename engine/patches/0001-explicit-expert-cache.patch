index 00000000..e612bb0f
--- /dev/null
+++ b/src/llama-expert-cache.cpp
@@ -0,0 +1,597 @@
+#include "llama-expert-cache.h"
+
+#include "llama-impl.h"
+#include "llama-model.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <iterator>
+#include <list>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#if defined(__linux__)
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#define EXPERT_CACHE_SUPPORTED 1
+#else
+#define EXPERT_CACHE_SUPPORTED 0
+#endif
+
+namespace {
+
+// A routing call with more tokens than this is prompt processing: its misses are
+// admitted at the eviction end so one pass over all experts cannot flush the hot set.
+constexpr int64_t SCAN_TOKENS = 16;
+// Share of the budget the protected segment (experts hit at least twice) may use.
+constexpr double PROTECTED_SHARE = 0.8;
+// Read granularity: large enough for NVMe efficiency, small enough to spread over threads.
+constexpr size_t CHUNK = 1 << 20;
+
+size_t page_size() {
+#if EXPERT_CACHE_SUPPORTED
+    static const size_t p = (size_t) sysconf(_SC_PAGESIZE);
+    return p;
+#else
+    return 4096;
+#endif
+}
+
+uint8_t * align_down(uint8_t * p) { return (uint8_t *) ((uintptr_t) p & ~(uintptr_t) (page_size() - 1)); }
+uint8_t * align_up(uint8_t * p)   { return align_down(p + page_size() - 1); }
+
+struct file_map {
+    std::string path;
+    uint8_t *   base = nullptr;
+    size_t      size = 0;
+    int         fd_direct = -1;   // O_DIRECT: reads bypass the page cache
+    int         fd_buffered = -1; // fallback when the filesystem refuses O_DIRECT
+};
+
+// All experts of one expert weight tensor ([n_embd, n_ff, n_expert] or similar).
+struct region {
+    int       file = -1;
+    uint8_t * data = nullptr;  // tensor data (inside the file mapping)
+    size_t    slice = 0;       // bytes per expert (nb[2])
+    int64_t   n_expert = 0;
+    uint8_t * lo = nullptr;    // page-aligned interior we manage: [lo, hi)
+    uint8_t * hi = nullptr;
+};
+
+struct read_job {
+    const file_map * file;
+    size_t           file_off;
+    uint8_t *        dst;
+    size_t           len;
+};
+
+struct entry {
+    bool     resident = false;
+    bool     prot = false;   // in the protected segment
+    uint64_t in_use = 0;     // routing call that needs it; never evicted during that call
+    std::list<uint64_t>::iterator pos;
+};
+
+} // namespace
+
+struct llama_expert_cache;
+
+struct layer_state {
+    llama_expert_cache *  cache = nullptr;
+    int                   il = 0;
+    std::vector<int>      regions;
+    int64_t               n_expert = 0;
+    size_t                expert_bytes = 0;  // all regions' slices of one expert
+    std::vector<entry>    entries;
+    std::vector<read_job> jobs;              // planned by plan_op, executed by load_op
+};
+
+struct llama_expert_cache {
+    size_t budget = 0;
+    size_t used = 0;
+    size_t prot_bytes = 0;
+    uint64_t call = 0;
+
+    std::vector<file_map> files;
+    std::vector<region>   regions;
+    std::unordered_map<const ggml_tensor *, int> region_of;
+    std::unordered_map<int, std::unique_ptr<layer_state>> layers;
+
+    // Front = most recently used. Keys are (layer << 32) | expert.
+    std::list<uint64_t> probation;
+    std::list<uint64_t> protect;
+
+    // Every tensor range inside the mappings; on first use, everything except the
+    // managed expert interiors becomes resident anonymous memory (non-expert weights
+    // would otherwise be evicted by the page cache and re-read every token).
+    std::vector<std::pair<uint8_t *, uint8_t *>> tensor_ranges;
+    bool dense_resident = false;
+    size_t dense_bytes = 0;
+    // Expert bytes one decoded token touches across all layers (n_used experts per layer).
+    // When the budget is smaller, recency-based eviction cycles through everything and keeps
+    // nothing, so misses are then admitted "cold" to keep a stable resident set instead.
+    size_t working_set = 0;
+
+    // Statistics.
+    uint64_t hits = 0, misses = 0, evictions = 0, calls = 0;
+    std::atomic<uint64_t> bytes_read{0};
+    uint64_t log_every = 0;
+    uint64_t next_log = 0;
+
+    ~llama_expert_cache() {
+        log_stats("final");
+#if EXPERT_CACHE_SUPPORTED
+        for (auto & f : files) {
+            if (f.fd_direct >= 0) close(f.fd_direct);
+            if (f.fd_buffered >= 0) close(f.fd_buffered);
+        }
+#endif
+    }
+
+    void log_stats(const char * when) const {
+        const uint64_t total = hits + misses;
+        LLAMA_LOG_INFO("expert cache (%s): %.1f%% hit rate (%llu hits, %llu misses), %.2f GiB read, "
+                       "%llu evictions, %.2f / %.2f GiB resident\n",
+                       when, total ? 100.0 * hits / total : 0.0, (unsigned long long) hits,
+                       (unsigned long long) misses, bytes_read.load() / 1073741824.0,
+                       (unsigned long long) evictions, used / 1073741824.0, budget / 1073741824.0);
+    }
+
+    static uint64_t key(int il, int64_t e) { return ((uint64_t) il << 32) | (uint64_t) e; }
+    entry & entry_of(uint64_t k) { return layers.at((int) (k >> 32))->entries[k & 0xffffffffu]; }
+
+    int add_region(const ggml_tensor * t);
+    layer_state * layer(int il, std::initializer_list<ggml_tensor *> weights);
+
+    void make_dense_resident();
+    void touch(uint64_t k, entry & en);
+    void evict(uint64_t k);
+    void make_room(size_t need);
+    void admit(layer_state & ls, int64_t e, bool cold);
+};
+
+int llama_expert_cache::add_region(const ggml_tensor * t) {
+    auto it = region_of.find(t);
+    if (it != region_of.end()) {
+        return it->second;
+    }
+    uint8_t * data = (uint8_t *) t->data;
+    int file = -1;
+    for (size_t i = 0; i < files.size(); ++i) {
+        if (data >= files[i].base && data + ggml_nbytes(t) <= files[i].base + files[i].size) {
+            file = (int) i;
+            break;
+        }
+    }
+    if (file < 0) {
+        LLAMA_LOG_WARN("%s: %s is not memory-mapped from the model file; not cached\n", __func__, t->name);
+        return region_of[t] = -1;
+    }
+    region r;
+    r.file = file;
+    r.data = data;
+    r.slice = t->nb[2];
+    r.n_expert = t->ne[2];
+    r.lo = align_up(data);
+    r.hi = align_down(data + ggml_nbytes(t));
+#if EXPERT_CACHE_SUPPORTED
+    if (r.hi > r.lo) {
+        // Same addresses, but anonymous memory we fill ourselves instead of file pages
+        // the kernel manages. Initially nothing is resident.
+        void * p = mmap(r.lo, r.hi - r.lo, PROT_READ | PROT_WRITE,
+                        MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | MAP_NORESERVE, -1, 0);
+        if (p != (void *) r.lo) {
+            LLAMA_LOG_WARN("%s: remapping %s failed: %s; not cached\n", __func__, t->name, strerror(errno));
+            return region_of[t] = -1;
+        }
+        const file_map & f = files[file];
+        posix_fadvise(f.fd_buffered, r.lo - f.base, r.hi - r.lo, POSIX_FADV_DONTNEED);
+    }
+#endif
+    regions.push_back(r);
+    return region_of[t] = (int) regions.size() - 1;
+}
+
+layer_state * llama_expert_cache::layer(int il, std::initializer_list<ggml_tensor *> weights) {
+    auto it = layers.find(il);
+    if (it != layers.end()) {
+        return it->second->regions.empty() ? nullptr : it->second.get();
+    }
+    auto ls = std::make_unique<layer_state>();
+    ls->cache = this;
+    ls->il = il;
+    for (ggml_tensor * t : weights) {
+        if (t == nullptr || t->data == nullptr || t->ne[2] <= 1) {
+            continue;
+        }
+        const int r = add_region(t);
+        if (r < 0) {
+            continue;
+        }
+        if (ls->n_expert == 0) {
+            ls->n_expert = regions[r].n_expert;
+        }
+        if (regions[r].n_expert != ls->n_expert) {
+            LLAMA_LOG_WARN("%s: layer %d mixes expert counts; not cached\n", __func__, il);
+            ls->regions.clear();
+            break;
+        }
+        ls->regions.push_back(r);
+        ls->expert_bytes += regions[r].slice;
+    }
+    ls->entries.resize(ls->n_expert);
+    layer_state * out = ls->regions.empty() ? nullptr : ls.get();
+    layers[il] = std::move(ls);
+    return out;
+}
+
+namespace {
+
+// Read [dst, dst + len) of `f` at the same file offset, in chunks, preferring direct I/O.
+void read_range(const file_map & f, uint8_t * dst, size_t len) {
+#if EXPERT_CACHE_SUPPORTED
+    size_t off = 0;
+    int fd = f.fd_direct >= 0 ? f.fd_direct : f.fd_buffered;
+    while (off < len) {
+        const size_t n = std::min(len - off, (size_t) 8 << 20);
+        ssize_t r = pread(fd, dst + off, n, (dst + off) - f.base);
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        if (r < 0 && fd == f.fd_direct) {
+            fd = f.fd_buffered;
+            continue;
+        }
+        if (r <= 0) {
+            GGML_ABORT("expert cache: reading %s failed: %s", f.path.c_str(), r < 0 ? strerror(errno) : "end of file");
+        }
+        off += (size_t) r;
+    }
+    posix_fadvise(f.fd_buffered, dst - f.base, len, POSIX_FADV_DONTNEED);
+#else
+    (void) f; (void) dst; (void) len;
+#endif
+}
+
+} // namespace
+
+void llama_expert_cache::make_dense_resident() {
+    dense_resident = true;
+#if EXPERT_CACHE_SUPPORTED
+    // Page ranges of all tensors, merged.
+    std::vector<std::pair<uint8_t *, uint8_t *>> segs;
+    for (auto [s, e] : tensor_ranges) {
+        segs.push_back({align_down(s), align_up(e)});
+    }
+    std::sort(segs.begin(), segs.end());
+    std::vector<std::pair<uint8_t *, uint8_t *>> merged;
+    for (auto & s : segs) {
+        if (!merged.empty() && s.first <= merged.back().second) {
+            merged.back().second = std::max(merged.back().second, s.second);
+        } else {
+            merged.push_back(s);
+        }
+    }
+    // Minus the managed expert interiors.
+    std::vector<std::pair<uint8_t *, uint8_t *>> holes;
+    for (const region & r : regions) {
+        if (r.hi > r.lo) {
+            holes.push_back({r.lo, r.hi});
+        }
+    }
+    std::sort(holes.begin(), holes.end());
+    // Replace [s, e) with anonymous memory holding the file content, per file mapping.
+    auto make_resident = [&](uint8_t * s, uint8_t * e) {
+        for (const file_map & f : files) {
+            uint8_t * a = std::max(s, f.base);
+            uint8_t * b = std::min(e, align_down(f.base + f.size));
+            if (b <= a) {
+                continue;
+            }
+            if (mmap(a, b - a, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED | MAP_NORESERVE, -1, 0) != (void *) a) {
+                LLAMA_LOG_WARN("%s: remapping %zu bytes failed: %s\n", __func__, (size_t) (b - a), strerror(errno));
+                continue;
+            }
+            read_range(f, a, b - a);
+            dense_bytes += b - a;
+        }
+    };
+    for (auto [s, e] : merged) {
+        uint8_t * p = s;
+        for (auto [hs, he] : holes) {
+            if (he <= p || hs >= e) {
+                continue;
+            }
+            if (hs > p) {
+                make_resident(p, hs);
+            }
+            p = std::max(p, he);
+        }
+        if (p < e) {
+            make_resident(p, e);
+        }
+    }
+    LLAMA_LOG_INFO("expert cache: %.2f GiB of non-expert weights made resident\n", dense_bytes / 1073741824.0);
+#endif
+}
+
+// A hit: decode hits promote probation -> protected; protected hits refresh recency.
+void llama_expert_cache::touch(uint64_t k, entry & en) {
+    const size_t bytes = layers.at((int) (k >> 32))->expert_bytes;
+    if (en.prot) {
+        protect.splice(protect.begin(), protect, en.pos);
+        return;
+    }
+    probation.erase(en.pos);
+    protect.push_front(k);
+    en.pos = protect.begin();
+    en.prot = true;
+    prot_bytes += bytes;
+    // Keep the protected segment within its share; demote its LRU end to probation.
+    while (prot_bytes > PROTECTED_SHARE * budget && protect.size() > 1) {
+        const uint64_t v = protect.back();
+        entry & ve = entry_of(v);
+        protect.pop_back();
+        probation.push_front(v);
+        ve.pos = probation.begin();
+        ve.prot = false;
+        prot_bytes -= layers.at((int) (v >> 32))->expert_bytes;
+    }
+}
+
+void llama_expert_cache::evict(uint64_t k) {
+    layer_state & ls = *layers.at((int) (k >> 32));
+    const int64_t e = (int64_t) (k & 0xffffffffu);
+    entry & en = ls.entries[e];
+#if EXPERT_CACHE_SUPPORTED
+    for (int ri : ls.regions) {
+        const region & r = regions[ri];
+        // Only pages entirely inside this expert's slice: boundary pages may hold a
+        // neighbour's bytes. They stay resident (always with correct file content).
+        uint8_t * s = std::max(align_up(r.data + e * r.slice), r.lo);
+        uint8_t * t = std::min(align_down(r.data + (e + 1) * r.slice), r.hi);
+        if (t > s) {
+            madvise(s, t - s, MADV_DONTNEED);
+        }
+    }
+#endif
+    (en.prot ? protect : probation).erase(en.pos);
+    if (en.prot) {
+        prot_bytes -= ls.expert_bytes;
+    }
+    en.resident = false;
+    en.prot = false;
+    used -= ls.expert_bytes;
+    ++evictions;
+}
+
+void llama_expert_cache::make_room(size_t need) {
+    // Evict from the probation LRU end first, then from the protected LRU end.
+    for (auto * seg : {&probation, &protect}) {
+        auto it = seg->end();
+        while (used + need > budget && it != seg->begin()) {
+            auto cur = std::prev(it);
+            if (entry_of(*cur).in_use == call) {
+                it = cur;  // needed by the layer about to run
+                continue;
+            }
+            evict(*cur);   // erases cur; `it` stays valid
+        }
+    }
+    // If everything left is needed right now we overshoot the budget for this layer.
+}
+
+void llama_expert_cache::admit(layer_state & ls, int64_t e, bool cold) {
+    entry & en = ls.entries[e];
+    const uint64_t k = key(ls.il, e);
+    if (cold) {
+        probation.push_back(k);
+        en.pos = std::prev(probation.end());
+    } else {
+        probation.push_front(k);
+        en.pos = probation.begin();
+    }
+    en.resident = true;
+    en.prot = false;
+    used += ls.expert_bytes;
+
+    for (int ri : ls.regions) {
+        const region & r = regions[ri];
+        uint8_t * s = std::max(align_down(r.data + e * r.slice), r.lo);
+        uint8_t * t = std::min(align_up(r.data + (e + 1) * r.slice), r.hi);
+        const file_map & f = files[r.file];
+        for (uint8_t * p = s; p < t; p += CHUNK) {
+            ls.jobs.push_back({&f, (size_t) (p - f.base), p, std::min(CHUNK, (size_t) (t - p))});
+        }
+    }
+}
+
+namespace {
+
+// Copy the routing ids (possibly a strided view) into dst, contiguous.
+void copy_ids(ggml_tensor * dst, const ggml_tensor * a) {
+    int32_t * out = (int32_t *) dst->data;
+    for (int64_t i3 = 0; i3 < a->ne[3]; ++i3)
+    for (int64_t i2 = 0; i2 < a->ne[2]; ++i2)
+    for (int64_t i1 = 0; i1 < a->ne[1]; ++i1)
+    for (int64_t i0 = 0; i0 < a->ne[0]; ++i0) {
+        *out++ = *(const int32_t *) ((const char *) a->data + i0 * a->nb[0] + i1 * a->nb[1] + i2 * a->nb[2] + i3 * a->nb[3]);
+    }
+}
+
+// Runs on one thread before the layer's expert matmuls: decides hits, evictions and reads.
+void plan_op(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata) {
+    (void) nth;
+    if (ith != 0) {
+        return;
+    }
+    layer_state & ls = *(layer_state *) userdata;
+    llama_expert_cache & c = *ls.cache;
+    if (!c.dense_resident) {
+        c.make_dense_resident();  // all layers are registered by now (graph built)
+        for (const auto & [il, l] : c.layers) {
+            c.working_set += l->expert_bytes * (size_t) a->ne[0];
+        }
+        LLAMA_LOG_INFO("expert cache: %.2f GiB of experts per token; %s\n", c.working_set / 1073741824.0,
+                       c.budget < c.working_set ? "budget is smaller, keeping a stable resident set"
+                                                : "budget holds at least one token's experts");
+    }
+    copy_ids(dst, a);
+
+    const int64_t n = ggml_nelements(a);
+    const bool prefill = n / a->ne[0] > SCAN_TOKENS;
+    // Cold admission: prompt sweeps, or decoding with a budget below one token's experts.
+    const bool cold = prefill || c.budget < c.working_set;
+    const uint64_t call = ++c.call;
+    const int32_t * ids = (const int32_t *) dst->data;
+
+    ls.jobs.clear();
+    std::vector<int64_t> missing;
+    size_t need = 0;
+    for (int64_t i = 0; i < n; ++i) {
+        const int64_t e = ids[i];
+        if (e < 0 || e >= ls.n_expert) {
+            continue;
+        }
+        entry & en = ls.entries[e];
+        if (en.in_use == call) {
+            continue;  // duplicate within this batch
+        }
+        en.in_use = call;
+        if (en.resident) {
+            ++c.hits;
+            if (!prefill) {
+                c.touch(llama_expert_cache::key(ls.il, e), en);
+            }
+        } else {
+            ++c.misses;
+            missing.push_back(e);
+            need += ls.expert_bytes;
+        }
+    }
+    c.make_room(need);
+    for (int64_t e : missing) {
+        c.admit(ls, e, cold);
+    }
+
+    ++c.calls;
+    if (c.log_every && c.calls >= c.next_log) {
+        c.next_log = c.calls + c.log_every;
+        c.log_stats("running");
+    }
+}
+
+// Runs on all threads: executes the planned reads, then passes the ids through.
+void load_op(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata) {
+    layer_state & ls = *(layer_state *) userdata;
+    uint64_t done = 0;
+#if EXPERT_CACHE_SUPPORTED
+    for (size_t j = ith; j < ls.jobs.size(); j += nth) {
+        const read_job & job = ls.jobs[j];
+        int fd = job.file->fd_direct >= 0 ? job.file->fd_direct : job.file->fd_buffered;
+        size_t off = 0;
+        while (off < job.len) {
+            ssize_t r = pread(fd, job.dst + off, job.len - off, job.file_off + off);
+            if (r < 0 && errno == EINTR) {
+                continue;
+            }
+            if (r < 0 && fd == job.file->fd_direct) {
+                fd = job.file->fd_buffered;  // e.g. unaligned tail: retry buffered
+                continue;
+            }
+            if (r <= 0) {
+                GGML_ABORT("expert cache: reading %s at %zu failed: %s", job.file->path.c_str(),
+                           job.file_off + off, r < 0 ? strerror(errno) : "end of file");
+            }
+            off += (size_t) r;
+        }
+        if (fd == job.file->fd_buffered) {
+            posix_fadvise(fd, job.file_off, job.len, POSIX_FADV_DONTNEED);
+        }
+        done += job.len;
+    }
+#endif
+    ls.cache->bytes_read += done;
+    if (ith == 0) {
+        memcpy(dst->data, a->data, ggml_nbytes(a));
+    }
+}
+
+} // namespace
+
+std::shared_ptr<llama_expert_cache> llama_expert_cache_create(const llama_model & model, size_t budget_bytes) {
+    if (auto existing = model.expert_cache.lock()) {
+        return existing;  // one cache per model: it owns the model's expert memory
+    }
+#if EXPERT_CACHE_SUPPORTED
+    if (model.mappings.empty() || model.mapping_paths.size() != model.mappings.size()) {
+        LLAMA_LOG_WARN("%s: the model is not memory-mapped (--no-mmap?); expert cache disabled\n", __func__);
+        return nullptr;
+    }
+    auto c = std::make_shared<llama_expert_cache>();
+    c->budget = budget_bytes;
+    for (size_t i = 0; i < model.mappings.size(); ++i) {
+        const auto & m = model.mappings[i];
+        if (m->is_anonymous()) {
+            LLAMA_LOG_WARN("%s: the model is mapped on anonymous huge pages; expert cache disabled\n", __func__);
+            return nullptr;
+        }
+        file_map f;
+        f.path = model.mapping_paths[i];
+        f.base = (uint8_t *) m->addr();
+        f.size = m->size();
+        f.fd_direct = open(f.path.c_str(), O_RDONLY | O_DIRECT);
+        f.fd_buffered = open(f.path.c_str(), O_RDONLY);
+        if (f.fd_buffered < 0) {
+            LLAMA_LOG_WARN("%s: cannot open %s: %s; expert cache disabled\n", __func__, f.path.c_str(), strerror(errno));
+            return nullptr;
+        }
+        c->files.push_back(f);
+    }
+    for (const auto & [name, t] : model.tensors_by_name) {
+        uint8_t * d = (uint8_t *) t->data;
+        for (const auto & f : c->files) {
+            if (d && d >= f.base && d + ggml_nbytes(t) <= f.base + f.size) {
+                c->tensor_ranges.push_back({d, d + ggml_nbytes(t)});
+                break;
+            }
+        }
+    }
+    if (const char * env = getenv("LLAMA_EXPERT_CACHE_LOG")) {
+        c->log_every = (uint64_t) std::max(0, atoi(env));
+        c->next_log = c->log_every;
+    }
+    LLAMA_LOG_INFO("%s: expert cache enabled, budget %.2f GiB, direct I/O %s\n", __func__,
+                   budget_bytes / 1073741824.0, c->files[0].fd_direct >= 0 ? "on" : "off (filesystem refused O_DIRECT)");
+    model.expert_cache = c;
+    return c;
+#else
+    (void) model;
+    (void) budget_bytes;
+    LLAMA_LOG_WARN("%s: the expert cache is only supported on Linux\n", __func__);
+    return nullptr;
+#endif
+}
+
+ggml_tensor * llama_expert_cache_wrap(ggml_context * ctx, llama_expert_cache * cache, int il, ggml_tensor * ids,
+                                      std::initializer_list<ggml_tensor *> weights) {
+    if (cache == nullptr) {
+        return ids;
+    }
+    layer_state * ls = cache->layer(il, weights);
+    if (ls == nullptr) {
+        return ids;
+    }
+    ggml_tensor * planned = ggml_map_custom1(ctx, ids, plan_op, 1, ls);
+    ggml_format_name(planned, "expert_cache_plan-%d", il);
+    ggml_tensor * loaded = ggml_map_custom1(ctx, planned, load_op, GGML_N_TASKS_MAX, ls);
+    ggml_format_name(loaded, "expert_cache_load-%d", il);
+    return loaded;
+}
