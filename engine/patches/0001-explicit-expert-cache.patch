+#pragma once
+
+// Explicit cache for MoE expert weights of a memory-mapped model that does not
+// fit in RAM.
+//
+// Without it, expert pages live in the OS page cache. Decode walks the layers in
+// the same order for every token, so once the working set exceeds free memory the
+// kernel's LRU evicts exactly the pages needed next and read-ahead multiplies the
+// disk traffic (see docs/BOTTLENECKS.md in cpu_inference_engine). This cache:
+//   * replaces the page-aligned interior of every expert tensor with anonymous
+//     memory at the same address, so kernels keep their pointers,
+//   * right before each MoE layer runs (routing ids are known), loads exactly the
+//     missing experts with direct I/O on all compute threads,
+//   * evicts whole experts by a segmented LRU: experts used twice are protected,
+//     experts loaded during prompt processing are evicted first (scan resistance).
+
+#include <cstddef>
+#include <initializer_list>
+#include <memory>
+
+struct ggml_context;
+struct ggml_tensor;
+struct llama_model;
+struct llama_expert_cache;
+
+// Returns the model's existing cache if it has one (the cache owns the model's expert
+// memory, so every context on the model must share it), otherwise creates one.
+// Returns nullptr (and logs why) when the model is not memory-mapped from files.
+std::shared_ptr<llama_expert_cache> llama_expert_cache_create(const llama_model & model, size_t budget_bytes);
+
+// Graph hook for one MoE layer: returns the tensor to use as expert ids for the
+// expert matmuls. The returned tensor carries the same ids; computing it first
+// makes the selected experts of `weights` resident.
+ggml_tensor * llama_expert_cache_wrap(ggml_context * ctx, llama_expert_cache * cache, int il, ggml_tensor * ids,
+                                      std::initializer_list<ggml_tensor *> weights);
