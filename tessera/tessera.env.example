# Tessera settings. Copy to tessera/tessera.env and edit. Any value can also be set in the environment,
# which wins over this file.

# Where the engine, the models and the profiles go. Keep it on the Linux side in WSL, never under /mnt/c.
INSTALL_DIR=$HOME/tessera

# The model: a Hugging Face repository and a name pattern for the files to download (scripts/download.sh --list
# shows what a repository has), or MODEL_FILE for a .gguf you already have (the first shard of a split model).
MODEL_REPO=unsloth/Qwen3-Next-80B-A3B-Instruct-GGUF
MODEL_PATTERN=UD-Q3_K_XL
MODEL_FILE=

# CPU only: 1 runs everything on the CPU from RAM (plus the SSD tier), with no CUDA toolkit and no build for the GPU.
# auto: CPU only when the engine was built without CUDA or no NVIDIA GPU is visible.
CPU_ONLY=auto

# Context tokens. More context takes VRAM from the hot experts (tools/plan.py shows the trade).
CTX=32768
# CPU threads for the experts that are not hot. Intel 12th-14th gen: the performance cores (6 on an i5-13400F).
# A VM or server: every core (8 vCPUs ran 18% faster than 6). scripts/bench.sh --threads "6 8 10" measures it.
THREADS=6

# VRAM for hot experts and RAM for the SSD tier's expert cache, in MiB. auto: tools/plan.py decides from the model,
# the GPU and free RAM. CACHE_MIB=0 leaves experts that do not fit in RAM to the OS page cache.
HOT_MIB=auto
CACHE_MIB=auto
# Hot-expert profile (most-used experts first). Default: $INSTALL_DIR/profiles/<model>.profile, written by
# scripts/calibrate.sh. Without one, no expert is hot.
PROFILE=

HOST=127.0.0.1
PORT=8080
API_KEY=
EXTRA_ARGS=

# The engine: ik_llama.cpp at a pinned commit plus tessera/engine/patches.
IK_LLAMA_REPO=https://github.com/ikawrakow/ik_llama.cpp.git
IK_LLAMA_COMMIT=d741de5074cd424dd3ba7cfc4d9b7649f1eb0463
