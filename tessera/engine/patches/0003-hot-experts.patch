+#pragma once
+
+// Hot experts: a static copy of the most-used MoE experts in VRAM (Tessera, after Strata's VRAM expert cache).
+//
+// With the expert tensors on the CPU (-ot exps=CPU / --cpu-moe) every routed expert is computed by the CPU from
+// RAM. Routing is uneven, so a few thousand experts carry most of the traffic. At load time the experts named by
+// a profile (most-used first) are copied into VRAM until a budget is used up. Each MoE layer then splits its
+// routed experts by id:
+//   * the hot ones run on the GPU from the copies (the CPU's ids for them are -1),
+//   * the rest run on the CPU from RAM (the GPU's ids for them are -1),
+// and the two partial sums are added. The GPU half is queued first and the CPU half's inputs are copied to the
+// host before it, so both halves run at the same time. Kernels skip id -1 already (it is how -ser drops experts).
+//
+// Profile format: text, one "layer expert" pair per line, most used first; '#' starts a comment.
+// tools/make_profile.py in Tessera writes it from routing traces (TESSERA_ROUTING_TRACE below).
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+struct ggml_context;
+struct ggml_tensor;
+struct ggml_backend_buffer;
+struct llama_model;
+
+struct llama_hot_layer {
+    // the hot experts' slices of the layer's expert tensors, [.., .., n_hot], in VRAM (null when absent)
+    ggml_tensor * up      = nullptr;
+    ggml_tensor * gate    = nullptr;
+    ggml_tensor * down    = nullptr;
+    ggml_tensor * up_gate = nullptr;
+    std::vector<int32_t> hot_of;   // per expert: its index in the hot tensors, or -1
+    int32_t n_hot = 0;
+};
+
+struct llama_hot_experts {
+    std::vector<llama_hot_layer> layers;   // per model layer; n_hot == 0: the layer is not split
+    ggml_context * ctx = nullptr;
+    ggml_backend_buffer * buf = nullptr;
+    size_t bytes = 0;
+    int64_t n_hot = 0;
+    ~llama_hot_experts();
+
+    const llama_hot_layer * layer(int il) const {
+        return il >= 0 && il < (int) layers.size() && layers[il].n_hot > 0 ? &layers[il] : nullptr;
+    }
+};
+
+// Copies the profile's experts (most used first) into the model's main GPU until `budget_bytes` is used.
+// Returns nullptr (and sets `err`) when nothing could be placed; the model then runs unchanged.
+std::shared_ptr<llama_hot_experts> llama_hot_experts_load(const llama_model & model, const std::string & profile,
+                                                          size_t budget_bytes, std::string & err);
+
+// Graph helper: the routed ids remapped for one half of the split. hot = true: indices into the hot tensors, -1 for
+// the others; hot = false: the original ids, -1 for the hot ones. `deps` are only inputs, so that the scheduler copies
+// them to the host in the same split (before the GPU half is queued): pass what the CPU half reads.
+ggml_tensor * llama_hot_ids(ggml_context * ctx, const llama_hot_layer & hl, ggml_tensor * ids, bool hot,
+                            ggml_tensor * dep0 = nullptr, ggml_tensor * dep1 = nullptr);
+
+// Routing trace: with TESSERA_ROUTING_TRACE=<file>, every MoE layer appends its routed ids to <file>
+// (records: int32 layer, int32 n_tokens, int32 k, then n_tokens * k int32 ids). Returns `ids` unchanged when off.
+ggml_tensor * llama_routing_trace_wrap(ggml_context * ctx, int il, ggml_tensor * ids);
