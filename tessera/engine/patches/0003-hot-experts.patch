+// The layer's routed-expert weight tensors, in the order the hot copies are stored.
+struct expert_tensors {
+    ggml_tensor * up = nullptr, * gate = nullptr, * down = nullptr, * up_gate = nullptr;
+    // bytes of one expert across all of them; 0 if the layer cannot be split
+    size_t expert_bytes() const {
+        size_t b = 0;
+        for (ggml_tensor * t : {up, gate, down, up_gate}) {
+            if (t) b += t->nb[2];
+        }
+        return b;
+    }
+};
+
+bool splittable(const ggml_tensor * t, int64_t n_expert) {
+    // host memory (-ot exps=CPU), one plain 3D tensor per layer (no multi-GPU split), experts contiguous
+    return t && t->buffer && ggml_backend_buffer_is_host(t->buffer) && !t->extra && t->data && t->ne[2] == n_expert &&
+           t->ne[3] == 1 && ggml_is_contiguous(t);
+}
+
+expert_tensors layer_tensors(const llama_layer & l, int64_t n_expert) {
+    expert_tensors t;
+    if (!l.ffn_down_exps || !splittable(l.ffn_down_exps, n_expert)) return t;
+    if (l.ffn_up_gate_exps) {
+        if (!splittable(l.ffn_up_gate_exps, n_expert) || l.ffn_up_exps || l.ffn_gate_exps) return t;
+        t.up_gate = l.ffn_up_gate_exps;
+    } else {
+        if (!splittable(l.ffn_up_exps, n_expert) || !splittable(l.ffn_gate_exps, n_expert)) return t;
+        t.up = l.ffn_up_exps;
+        t.gate = l.ffn_gate_exps;
+    }
+    // biased or scaled experts would need their per-expert extras remapped too: not split
+    if (l.ffn_up_exps_b || l.ffn_gate_exps_b || l.ffn_down_exps_b || l.ffn_up_gate_exps_b || l.ffn_down_exps_s) return t;
+    t.down = l.ffn_down_exps;
+    return t;
+}
+
+void strided_ids(const ggml_tensor * a, std::vector<int32_t> & out) {
+    out.clear();
+    for (int64_t i3 = 0; i3 < a->ne[3]; ++i3)
+    for (int64_t i2 = 0; i2 < a->ne[2]; ++i2)
+    for (int64_t i1 = 0; i1 < a->ne[1]; ++i1)
+    for (int64_t i0 = 0; i0 < a->ne[0]; ++i0) {
+        out.push_back(*(const int32_t *) ((const char *) a->data + i0 * a->nb[0] + i1 * a->nb[1] + i2 * a->nb[2] +
+                                          i3 * a->nb[3]));
+    }
+}
+
+// dst (contiguous, same shape as a) = the remapped ids; userdata = the layer, sign of the pointer's tag = which half
+template <bool hot>
+void remap_op(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, const llama_hot_layer & hl) {
+    (void) nth;
+    if (ith != 0) return;
+    static thread_local std::vector<int32_t> ids;
+    strided_ids(a, ids);
+    int32_t * out = (int32_t *) dst->data;
+    const int32_t n = (int32_t) hl.hot_of.size();
+    for (size_t i = 0; i < ids.size(); ++i) {
+        const int32_t e = ids[i];
+        const int32_t h = e >= 0 && e < n ? hl.hot_of[e] : -1;
+        out[i] = hot ? h : (h >= 0 ? -1 : e);
+    }
+}
+
+void remap_hot1(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * ud) {
+    remap_op<true>(dst, a, ith, nth, *(const llama_hot_layer *) ud);
+}
+void remap_cold1(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * ud) {
+    remap_op<false>(dst, a, ith, nth, *(const llama_hot_layer *) ud);
+}
+void remap_hot2(ggml_tensor * dst, const ggml_tensor * a, const ggml_tensor *, int ith, int nth, void * ud) {
+    remap_op<true>(dst, a, ith, nth, *(const llama_hot_layer *) ud);
+}
+void remap_cold2(ggml_tensor * dst, const ggml_tensor * a, const ggml_tensor *, int ith, int nth, void * ud) {
+    remap_op<false>(dst, a, ith, nth, *(const llama_hot_layer *) ud);
+}
+void remap_hot3(ggml_tensor * dst, const ggml_tensor * a, const ggml_tensor *, const ggml_tensor *, int ith, int nth,
+                void * ud) {
+    remap_op<true>(dst, a, ith, nth, *(const llama_hot_layer *) ud);
+}
+void remap_cold3(ggml_tensor * dst, const ggml_tensor * a, const ggml_tensor *, const ggml_tensor *, int ith, int nth,
+                 void * ud) {
+    remap_op<false>(dst, a, ith, nth, *(const llama_hot_layer *) ud);
+}
+
+// ---- routing trace
+
+struct routing_trace {
+    std::mutex mu;
+    FILE * f = nullptr;
+    ~routing_trace() { if (f) fclose(f); }
+};
+
+routing_trace * trace_file() {
+    static routing_trace * t = [] {
+        const char * path = std::getenv("TESSERA_ROUTING_TRACE");
+        if (!path || !*path) return (routing_trace *) nullptr;
+        auto * r = new routing_trace();   // lives for the process
+        r->f = std::fopen(path, "ab");
+        if (!r->f) {
+            LLAMA_LOG_WARN("%s: cannot open %s for the routing trace\n", __func__, path);
+            delete r;
+            return (routing_trace *) nullptr;
+        }
+        LLAMA_LOG_INFO("%s: writing the routing trace to %s\n", __func__, path);
+        return r;
+    }();
+    return t;
+}
+
+void trace_op(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * ud) {
+    (void) nth;
+    if (ith != 0) return;
+    static thread_local std::vector<int32_t> ids;
+    strided_ids(a, ids);
+    std::memcpy(dst->data, ids.data(), ids.size() * sizeof(int32_t));
+    routing_trace * t = trace_file();
+    if (!t) return;
+    const int32_t head[3] = {(int32_t) (intptr_t) ud, (int32_t) (a->ne[1] * a->ne[2] * a->ne[3]), (int32_t) a->ne[0]};
+    std::lock_guard<std::mutex> lk(t->mu);
+    std::fwrite(head, sizeof(head), 1, t->f);
+    std::fwrite(ids.data(), sizeof(int32_t), ids.size(), t->f);
+}
+
+} // namespace
+
+std::shared_ptr<llama_hot_experts> llama_hot_experts_load(const llama_model & model, const std::string & profile,
+                                                          size_t budget_bytes, std::string & err) {
+    const int64_t n_layer = (int64_t) model.layers.size();
+    const int64_t n_expert = model.hparams.n_expert;
+    if (n_expert <= 0) { err = "the model has no routed experts"; return nullptr; }
+
+    std::ifstream in(profile);
+    if (!in) { err = "cannot open the profile " + profile; return nullptr; }
+    std::vector<std::pair<int32_t, int32_t>> ranked;
+    std::unordered_set<int64_t> seen;
+    std::string line;
+    while (std::getline(in, line)) {
+        const size_t hash = line.find('#');
+        if (hash != std::string::npos) line.resize(hash);
+        std::istringstream fields(line);
+        int64_t l, e;
+        if (!(fields >> l >> e)) continue;
+        if (l < 0 || l >= n_layer || e < 0 || e >= n_expert || !seen.insert(l * n_expert + e).second) continue;
+        ranked.emplace_back((int32_t) l, (int32_t) e);
+    }
+    if (ranked.empty()) { err = "the profile " + profile + " names no expert of this model"; return nullptr; }
+
+    // take pairs in rank order while they fit
+    std::vector<expert_tensors> lt(n_layer);
+    for (int64_t l = 0; l < n_layer; ++l) lt[l] = layer_tensors(model.layers[l], n_expert);
+    auto hot = std::make_shared<llama_hot_experts>();
+    hot->layers.resize(n_layer);
+    std::vector<std::vector<int32_t>> chosen(n_layer);
+    size_t used = 0;
+    for (const auto & [l, e] : ranked) {
+        const size_t b = lt[l].expert_bytes();
+        if (b == 0 || used + b > budget_bytes) continue;
+        chosen[l].push_back(e);
+        used += b;
+    }
+    if (used == 0) {
+        err = "no expert tensor is in host memory (use -ot exps=CPU), or the budget holds no expert";
+        return nullptr;
+    }
+
+    // one tensor per layer and kind, [ne0, ne1, n_hot], in the main GPU's buffer type
+    ggml_init_params ip = { (size_t) (4 * n_layer + 1) * ggml_tensor_overhead(), nullptr, true };
+    hot->ctx = ggml_init(ip);
+    if (!hot->ctx) { err = "ggml_init failed"; return nullptr; }
+    for (int64_t l = 0; l < n_layer; ++l) {
+        if (chosen[l].empty()) continue;
+        llama_hot_layer & hl = hot->layers[l];
+        hl.n_hot = (int32_t) chosen[l].size();
+        auto dup = [&](ggml_tensor * src, const char * kind) -> ggml_tensor * {
+            if (!src) return nullptr;
+            ggml_tensor * t = ggml_new_tensor_3d(hot->ctx, src->type, src->ne[0], src->ne[1], hl.n_hot);
+            ggml_format_name(t, "blk.%d.%s.hot", (int) l, kind);
+            return t;
+        };
+        hl.up      = dup(lt[l].up, "ffn_up_exps");
+        hl.gate    = dup(lt[l].gate, "ffn_gate_exps");
+        hl.down    = dup(lt[l].down, "ffn_down_exps");
+        hl.up_gate = dup(lt[l].up_gate, "ffn_up_gate_exps");
+    }
+    const int dev = model.devices.empty() ? model.main_gpu
+                                          : model.devices[std::clamp(model.main_gpu, 0, (int) model.devices.size() - 1)];
+    ggml_backend_buffer_type_t buft = model.default_buffer_type_offload(dev);
+    hot->buf = ggml_backend_alloc_ctx_tensors_from_buft(hot->ctx, buft);
+    if (!hot->buf) {
+        err = "cannot allocate " + std::to_string(used >> 20) + " MiB for the hot experts in " + ggml_backend_buft_name(buft);
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(hot->buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    for (int64_t l = 0; l < n_layer; ++l) {
+        llama_hot_layer & hl = hot->layers[l];
+        if (hl.n_hot == 0) continue;
+        hl.hot_of.assign((size_t) n_expert, -1);
+        std::sort(chosen[l].begin(), chosen[l].end());   // file order: sequential reads while copying
+        for (int32_t h = 0; h < hl.n_hot; ++h) {
+            const int32_t e = chosen[l][h];
+            hl.hot_of[e] = h;
+            const std::pair<ggml_tensor *, ggml_tensor *> copies[] = {
+                {lt[l].up, hl.up}, {lt[l].gate, hl.gate}, {lt[l].down, hl.down}, {lt[l].up_gate, hl.up_gate}};
+            for (const auto & [src, dst] : copies) {
+                if (!src) continue;
+                ggml_backend_tensor_set(dst, (const char *) src->data + (size_t) e * src->nb[2],
+                                        (size_t) h * dst->nb[2], src->nb[2]);
+            }
+        }
+        hot->n_hot += hl.n_hot;
+    }
+    hot->bytes = used;
+    int layers_split = 0;
+    for (const auto & hl : hot->layers) layers_split += hl.n_hot > 0;
+    LLAMA_LOG_INFO("%s: %lld hot experts (%.2f GiB) in %s over %d layers, from %s\n", __func__,
+                   (long long) hot->n_hot, used / 1073741824.0, ggml_backend_buft_name(buft), layers_split,
+                   profile.c_str());
+    return hot;
+}
+
+ggml_tensor * llama_hot_ids(ggml_context * ctx, const llama_hot_layer & hl, ggml_tensor * ids, bool hot,
+                            ggml_tensor * dep0, ggml_tensor * dep1) {
+    void * ud = const_cast<llama_hot_layer *>(&hl);   // the ops only read it
+    ggml_tensor * out;
+    if (dep0 && dep1) {
+        out = ggml_map_custom3(ctx, ids, dep0, dep1, hot ? remap_hot3 : remap_cold3, 1, ud);
+    } else if (dep0) {
+        out = ggml_map_custom2(ctx, ids, dep0, hot ? remap_hot2 : remap_cold2, 1, ud);
+    } else {
+        out = ggml_map_custom1(ctx, ids, hot ? remap_hot1 : remap_cold1, 1, ud);
+    }
+    return out;
+}
+
+ggml_tensor * llama_routing_trace_wrap(ggml_context * ctx, int il, ggml_tensor * ids) {
+    if (!trace_file()) return ids;
+    return ggml_map_custom1(ctx, ids, trace_op, 1, (void *) (intptr_t) il);
+}
