+// Memory left free when the budget is fitted to available memory (OS, allocations we cannot see).
+constexpr int64_t SLACK = 512ll << 20;
+
+int64_t read_int(const std::string & path) {
+    std::ifstream in(path);
+    long long v;
+    return in >> v ? (int64_t) v : -1;  // -1 also for "max"
+}
+
+int64_t stat_value(const std::string & path, const std::string & key) {
+    std::ifstream in(path);
+    std::string k;
+    long long v;
+    while (in >> k >> v) {
+        if (k == key) {
+            return v;
+        }
+    }
+    return 0;
+}
+
+// Memory this process can still use: MemAvailable, bounded by its memory cgroup's limit
+// (containers, systemd MemoryMax) less the cgroup's non-file usage. -1 if unknown.
+int64_t available_memory() {
+    int64_t avail = -1;
+    std::ifstream meminfo("/proc/meminfo");
+    std::string line;
+    while (std::getline(meminfo, line)) {
+        long long kb;
+        if (sscanf(line.c_str(), "MemAvailable: %lld kB", &kb) == 1) {
+            avail = (int64_t) kb * 1024;
+            break;
+        }
+    }
+    std::ifstream cgroups("/proc/self/cgroup");
+    while (std::getline(cgroups, line)) {
+        std::string dir, limit, usage, file_key;
+        size_t p;
+        if (line.rfind("0::", 0) == 0) {
+            dir = "/sys/fs/cgroup" + line.substr(3);
+            limit = "/memory.max", usage = "/memory.current", file_key = "file";
+        } else if ((p = line.find(":memory:")) != std::string::npos) {
+            dir = "/sys/fs/cgroup/memory" + line.substr(p + 8);
+            limit = "/memory.limit_in_bytes", usage = "/memory.usage_in_bytes", file_key = "total_cache";
+        } else {
+            continue;
+        }
+        const int64_t lim = read_int(dir + limit), use = read_int(dir + usage);
+        if (lim <= 0 || use < 0 || lim >= (int64_t) 1 << 60) {
+            continue;  // no limit
+        }
+        const int64_t cg_avail = lim - (use - stat_value(dir + "/memory.stat", file_key));
+        if (avail < 0 || cg_avail < avail) {
+            avail = cg_avail;
+        }
+    }
+    return avail;
+}
 
