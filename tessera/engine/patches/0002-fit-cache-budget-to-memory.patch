 // A hit: decode hits promote probation -> protected; protected hits refresh recency.
+// On first use (weights resident, context buffers allocated, no experts loaded yet): cap the
+// budget to what memory allows, so a budget sized too optimistically slows decoding down
+// instead of getting this or another process killed for lack of memory.
+void llama_expert_cache::fit_budget(int64_t n_used) {
+    const int64_t avail = available_memory();
+    if (avail < 0) {
+        return;
+    }
+    const int64_t limit = avail - (int64_t) reserve - SLACK;
+    if (limit >= (int64_t) budget) {
+        return;
+    }
+    size_t floor = 0;  // one layer's experts for one token
+    for (const auto & [il, l] : layers) {
+        floor = std::max(floor, l->expert_bytes * (size_t) n_used);
+    }
+    const size_t fitted = std::max(floor, (size_t) std::max<int64_t>(limit, 0));
+    LLAMA_LOG_WARN("expert cache: %.2f GiB available, %.2f GiB of it still needed by the KV cache and compute "
+                   "buffers: budget lowered from %.2f to %.2f GiB\n", avail / 1073741824.0,
+                   reserve / 1073741824.0, budget / 1073741824.0, fitted / 1073741824.0);
+    budget = fitted;
+}
